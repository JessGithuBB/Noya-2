{% extends "themes/base.html.twig" %}
{% block title %}Corps et Cheveux{% endblock %}
{% block description %}Retrouvez nos produits pour le soin de votre corps et vos cheveux{% endblock %}

    
{% block main %}
<div class="container-fluid">
    <section 
        class="page-header container-fluid py-5 mb-4 text-white position-relative"
        style="
            background-image: url('{{ asset('build/images/Corps-et-cheveux.png') }}');
            background-size: cover;
            background-position: center;
            min-height: 320px;
        ">
        <div class="container position-relative"></div>
    </section>
    
    {# KEYWORDS LIST #}
    {% include 'components/keywords.html.twig' with { 
        keywords: keywords,
        articles: articles 
    } %}
</div>

{% endblock %}


