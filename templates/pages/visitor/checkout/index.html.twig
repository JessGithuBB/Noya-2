{% extends "themes/base.html.twig" %}

{% block title %}Récapitulatif de la commande{% endblock %}
{% block description %}Vérifiez votre commande avant de procéder au paiement{% endblock %}

{% block main %}
{{ parent() }}

<div class="checkout-page">
    {# En-tête #}
    <section class="page-header container py-4 mb-4">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 fw-bold text-dark">
                    <i class="bi bi-bag-check text-success"></i> Récapitulatif de la commande
                </h1>
                <p class="text-muted">Vérifiez votre commande avant de procéder au paiement</p>
            </div>
            <div class="col-md-4 text-end">
                <a href="{{ path('app_cart_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour au panier
                </a>
            </div>
        </div>
    </section>

    <div class="container pb-5">
        <div class="row g-4">
            {# Colonne principale - Articles #}
            <div class="col-lg-8">
                {# Articles de la commande #}
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-box-seam"></i> Vos articles 
                            <span class="badge bg-success">{{ items|length }}</span>
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        {% for item in items %}
                            <div class="p-3 p-md-4 border-bottom">
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-2 col-3">
                                        <img src="{{ asset('uploads/images/' ~ item.article.image) }}" 
                                             alt="{{ item.article.name }}" 
                                             class="img-fluid rounded"
                                             style="max-height: 80px; object-fit: cover;">
                                    </div>
                                    <div class="col-md-6 col-9">
                                        <h6 class="mb-1 fw-semibold">{{ item.article.name }}</h6>
                                        <p class="text-muted small mb-0">{{ item.article.brand }}</p>
                                        <small class="text-muted">Quantité: {{ item.quantity }}</small>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <p class="mb-0 fw-bold text-success">
                                            {{ (item.article.sellingPrice * item.quantity)|number_format(2, ',', ' ') }} €
                                        </p>
                                        <small class="text-muted">{{ item.article.sellingPrice|number_format(2, ',', ' ') }} € × {{ item.quantity }}</small>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Informations de livraison #}
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-truck"></i> Informations de livraison
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info mb-0">
                            <i class="bi bi-info-circle"></i> 
                            Livraison gratuite sous 48h en France métropolitaine
                        </div>
                    </div>
                </div>
            </div>

            {# Colonne latérale - Récapitulatif #}
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 100px;">
                    <div class="card-header bg-success text-white py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-calculator"></i> Récapitulatif
                        </h5>
                    </div>
                    <div class="card-body">
                        {# Détails des coûts #}
                        <div class="d-flex justify-content-between mb-3">
                            <span>Sous-total ({{ items|length }} article{{ items|length > 1 ? 's' : '' }})</span>
                            <span class="fw-semibold">{{ total|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Livraison</span>
                            <span class="text-success fw-semibold">Offerte</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>TVA (20%)</span>
                            <span class="fw-semibold">{{ (total * 0.2)|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 mb-0">Total TTC</span>
                            <span class="h4 mb-0 text-success fw-bold">{{ total|number_format(2, ',', ' ') }} €</span>
                        </div>
                        
                        {# Bouton Continuer #}
                        <a href="{{ path('app_checkout_payment') }}" class="btn btn-success w-100 mb-3 py-3">
                            <i class="bi bi-credit-card"></i> Procéder au paiement
                        </a>
                        
                        {# Badges de confiance #}
                        <div class="text-center mb-2">
                            <small class="text-muted">
                                <i class="bi bi-shield-check text-success"></i> Paiement 100% sécurisé
                            </small>
                        </div>
                        <div class="text-center">
                            <small class="text-muted">
                                <i class="bi bi-arrow-repeat text-success"></i> Retours faciles sous 30 jours
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}


