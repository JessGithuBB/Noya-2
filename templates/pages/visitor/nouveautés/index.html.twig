{% extends "themes/base.html.twig" %}
{% block title %}Nouveautés{% endblock %}
{% block description %}Liste des nouveautés{% endblock %}

{% block main %}
{{ parent() }}

<div class="nouveautes-page">
    {# Bannière d'en-tête remplacée par la photo #}
    <section 
        class="page-header container-fluid py-5 mb-4 text-white position-relative"
        style="
            background-image: url('{{ asset('build/images/nos-nouveautés.png') }}');
            background-size: cover;
            background-position: center;
            min-height: 320px;
        ">
        <div class="container position-relative"></div>
    </section>

    {# Liste des articles #}
    <section class="articles-section container py-4">
        {% if articles is empty %}
            {# Message si aucune nouveauté #}
            <div class="alert alert-info text-center" role="alert">
                <i class="bi bi-info-circle fs-3 d-block mb-3"></i>
                <h4>Aucune nouveauté pour le moment</h4>
                <p>Nos nouveaux produits apparaîtront bientôt ici !</p>
                <a href="{{ path('app_visitor_welcome') }}" class="btn btn-primary mt-3">
                    <i class="bi bi-house"></i> Retour à l'accueil
                </a>
            </div>
        {% else %}
            {# Compteur d'articles #}
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h4 mb-0">
                    <span class="badge bg-success">{{ articles|length }}</span> 
                    {{ articles|length > 1 ? 'nouveaux produits' : 'nouveau produit' }}
                </h2>
</div>

            {# Grille de produits #}
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                {% for article in articles %}
                    <div class="col">
                        {% include 'components/product_card.html.twig' with {'article': article} %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
