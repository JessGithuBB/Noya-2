{% extends "themes/base.html.twig" %}
{% block title %} Problématique Cutanée{% endblock %}
{% block description %}Retrouvez nos produits en fonction de votre problématique cutanée{% endblock %}

    
{% block main %}
<div class="container-fluid">
    <section 
        class="page-header container-fluid py-5 mb-4 text-white position-relative"
        style="
            background-image: url('{{ asset('build/images/problématique-cutanée.png') }}');
            background-size: cover;
            background-position: center;
            min-height: 320px;
        ">
        <div class="container position-relative"></div>
    </section>

    <div class="container py-4">
        <div class="row g-4">
            <div class="col-lg-3">
                {% include 'components/catalog_filters.html.twig' with {
                    filterOptions: filterOptions,
                    issueOptions: issueOptions,
                    ratingOptions: ratingOptions,
                    selectedTypes: selectedTypes,
                    selectedIssues: selectedIssues,
                    selectedRatings: selectedRatings,
                    selectedSort: selectedSort,
                    hasActiveFilters: hasActiveFilters,
                    filterFormId: filterFormId
                } %}
            </div>
            <div class="col-lg-9">
                {% if articles is defined and articles is not empty %}
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                        <h2 class="h4 mb-0">
                            <span class="badge bg-success me-2">{{ articles|length }}</span>
                            {{ articles|length > 1 ? 'produits trouvés' : 'produit trouvé' }}
                        </h2>
                    </div>
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
                        {% for article in articles %}
                            <div class="col">
                                {% include 'components/product_card.html.twig' with {'article': article} %}
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="alert alert-info text-center" role="alert">
                        <i class="bi bi-info-circle fs-3 d-block mb-3"></i>
                        <h4>Aucun produit trouvé</h4>
                        <p>Essayez de modifier vos filtres ou explorez nos autres catégories.</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{% endblock %}
