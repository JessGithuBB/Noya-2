{#
  Fragment des éléments de navigation (li) réutilisé en mobile et desktop.
  Utilise un suffixe pour éviter les IDs dupliqués dans les dropdowns.
  Exemple d'inclusion:
  {% include 'components/_nav_links.html.twig' with { suffix: 'Mobile' } %}
  {% include 'components/_nav_links.html.twig' with { suffix: 'Desktop' } %}
#}

{% set sfx = suffix is defined ? suffix : '' %}

